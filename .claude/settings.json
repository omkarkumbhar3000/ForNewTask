{
  "permissions": {
    "deny": [
      "PowerShell(git merge:*)",
      "Bash(git merge:*)",
      "PowerShell(git remote set-url:*)",
      "Bash(git remote set-url:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/BLAST/hooks/inject-objective.ps1\"",
            "timeout": 15,
            "statusMessage": "Loading BLAST/Objective.md"
          }
        ]
      }
    ]
  }
}
