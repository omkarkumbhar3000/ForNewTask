# =============================================================================
# Root .gitignore — BLAST framework + New Task work area
#
# Applies to everything below this folder, including an uploaded project in
# "New Task/Current Project/" and the work in "New Task/Updated Project/".
# A project may add its own nested .gitignore; these rules still apply.
# =============================================================================

# --- Credentials — never commit -----------------------------------------------
# Git history cannot be un-published. These must be excluded BEFORE a file is
# first staged, not corrected afterwards.
**/.env
**/*.env
**/.env.*
!**/.env.sample
!**/*.env.sample
!**/.env.example
**/.mcp.json
**/.claude/settings.local.json
**/.token
**/.token_cache.json
*.pem
*.pfx
*.p12
*.jks
*.keystore
*.key
*.ppk
id_rsa*
id_ed25519*
.git-credentials
.netrc
_netrc

# --- Regenerable build output and dependencies -------------------------------
node_modules/
dist/
build/
.vite/
.next/
.nuxt/
out/
target/
coverage/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.local

# --- Scratch and transient ---------------------------------------------------
# BLAST keeps all intermediates in .tmp/ (e.g. the PDF corpus from tools/rag).
.tmp/
*.tmp
*.bak
*.log

# --- OS / editor -------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
~$*
*.swp
*.orig
*.rej

# --- Local-only --------------------------------------------------------------
# The owner's private Marathi companion to CLI sessions. Never published.
mar.md
