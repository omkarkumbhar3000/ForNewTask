# Copy to .env and fill in. Never commit the real .env.

# ─── LLM provider ────────────────────────────────────────────────
# GROQ API key: https://console.groq.com/keys
GROQ_KEY=""

# ─── Jira (STANDBY — see MCP-SETUP.md) ───────────────────────────
# Only needed for a token-based MCP server (Option B).
# The Atlassian Remote MCP Server (Option A) uses browser OAuth and needs none of these.

# Jira base URL, e.g. https://your-domain.atlassian.net
JIRA_URL=""

# Jira account email
JIRA_EMAIL=""

# Jira API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=""
