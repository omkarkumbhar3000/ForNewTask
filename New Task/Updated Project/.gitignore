# CleverCubs project ignores. The repository root .gitignore applies as well; these keep the project
# safe if it is ever moved into its own repository.

# Secrets
.env
*.env
.env.local
.env.*.local
!.env.example

# Vercel CLI: the project link and the token file `vercel link` writes (docs/07-deployment.md). The CLI
# appends a broad `.env*` here on link or integration commands; keep it out, it would hide .env.example.
.vercel/

# Build output and dependencies
app/target/
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/

# Scratch
.tmp/
*.log
