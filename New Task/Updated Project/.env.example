# CleverCubs local configuration. Copy this file to .env in the same folder and fill in every value.
# .env is gitignored and must never be committed, printed or shared.
# docker-compose.yml reads it directly; the application imports it (app/src/main/resources/application.yml).

# --- Database (MySQL 8.4 in Docker) ---------------------------------------------------------------
# Use long random values, e.g. 24+ characters. Letters and digits only avoids shell-quoting problems.
CC_DB_ROOT_PASSWORD=
CC_DB_MIGRATOR_PASSWORD=
CC_DB_APP_PASSWORD=
CC_DB_URL=jdbc:mysql://127.0.0.1:3306/clevercubs

# --- First Super Admin (created only if no Super Admin exists yet) ---------------------------------
# The account must change this password at first sign-in. Remove the value from .env afterwards.
CC_ADMIN_EMAIL=
CC_ADMIN_INITIAL_PASSWORD=

# --- Content and site -------------------------------------------------------------------------------
# Folder holding the course media, relative to the app/ folder.
CC_MEDIA_ROOT=../media
# Shown on the Contact Us page (INF-02). Leave empty until the owner supplies it.
CC_CONTACT_EMAIL=
