# Copy to .env and fill in. .env is gitignored; this file documents the shape.

# ---------------------------------------------------------------- Jira connection
# JIRA_API_TOKEN: create at https://id.atlassian.com/manage-profile/security/api-tokens
# Auth is HTTP Basic with JIRA_EMAIL as the username and the token as the password.
JIRA_BASE_URL=https://<your-site>.atlassian.net
JIRA_PROJECT_KEY=PAMIT
JIRA_EMAIL=<you>@arconnet.com
JIRA_API_TOKEN=<atlassian-api-token>

# ------------------------------------------------------- Environment under test
# These populate the ticket's Environment field and the evidence header.
# Swap the whole block when targeting a different environment, e.g. QA_Indus,
# MS_Scale, Preprod_MsSQL. Names must match Environments/<env>.properties in the
# automation repo so a reader can reproduce the run.
TEST_ENVIRONMENT=QA_MsSQL
APPLICATION_URL=https://<host>:1302
API_URL=https://<host>:6302
BUILD_NUMBER=35.8.29 hf12
FIX_VERSION=35.8.29 hf12
AFFECTS_VERSION=35.8.29 hf12

# ------------------------------------------------------------------ Ticket defaults
JIRA_ISSUE_TYPE=Bug
JIRA_REPORTER_NAME=QA Automation
